# --- Required ---
# YouTube Live "Stream key" (YouTube Studio -> Go Live -> Stream).
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# --- Optional (sensible defaults shown) ---
YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
DASHBOARD_URL=https://tech-outage-botv2.vercel.app/
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
VIDEO_BITRATE=4500k
VIDEO_BUFSIZE=9000k
# Seconds to let the dashboard load / WebGL globe warm up before/after (re)launch.
PAGE_WARMUP_SECONDS=10
